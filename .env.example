# Demo mode: run without real payment / bot tokens
DEMO_MODE=true

# SQLite path
DATABASE_PATH=./data/signals.db

# Telegram (from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_PREMIUM_ROLE_ID=

# X / Twitter (stubs)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Payments
# Telegram Stars are handled in-bot; Stripe for Discord/X
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=

# Admin publisher
ADMIN_TOKEN=change-me-admin-token
ADMIN_HTTP_PORT=8787

# Free-tier knobs
FREE_SIGNALS_PER_DAY=2
FREE_DELAY_MINUTES=20
FREE_MAJORS_ONLY=true

# Referral
REFERRAL_BONUS_DAYS=7

# Live scanner dedup window (hours) for same pair+side open signals
SIGNAL_DEDUP_HOURS=6

# Public free channel for delayed alerts
TELEGRAM_FREE_CHANNEL=
TELEGRAM_FREE_CHANNEL_ID=
